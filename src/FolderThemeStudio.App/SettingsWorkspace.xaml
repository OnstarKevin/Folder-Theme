<UserControl x:Class="FolderThemeStudio.App.SettingsWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <StackPanel x:Name="SettingsOverview" Visibility="Collapsed">
   <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="选择要管理的功能" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,20"/>
   <UniformGrid Columns="2">
    <Button Style="{StaticResource FeatureCardButtonStyle}" Tag="general" Click="Module_Click" Margin="0,0,8,16"><StackPanel><TextBlock Text="常规" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="语言、启动与日常操作" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource FeatureCardButtonStyle}" Tag="features" Click="Module_Click" Margin="8,0,0,16"><StackPanel><TextBlock Text="功能开关" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="选择启用的功能" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource FeatureCardButtonStyle}" Tag="island" Click="Module_Click" Margin="0,0,8,16"><StackPanel><TextBlock Text="灵动岛" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="显示内容、位置与交互" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource FeatureCardButtonStyle}" Tag="appearance" Click="Module_Click" Margin="8,0,0,16"><StackPanel><TextBlock Text="外观与字体" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="背景、字体与动画" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource FeatureCardButtonStyle}" Tag="music" Click="Module_Click" Margin="0,0,8,16"><StackPanel><TextBlock Text="歌词与播放器" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="歌曲信息与歌词来源" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource FeatureCardButtonStyle}" Tag="messages" Click="Module_Click" Margin="8,0,0,16"><StackPanel><TextBlock Text="消息与剪贴板" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="通知、消息与本地接口" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource FeatureCardButtonStyle}" Tag="performance" Click="Module_Click" Margin="0,0,8,16"><StackPanel><TextBlock Text="性能" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="查看软件资源占用" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
   </UniformGrid>
  </StackPanel>
  <Button x:Name="BackToSettings" Content="← 返回全部设置" Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="Collapsed"/>
  <Border x:Name="ModuleCard" Background="#EFFFFFFF" CornerRadius="18" Padding="24" BorderBrush="#18000000" BorderThickness="1">
   <StackPanel>
    <TextBlock x:Name="ModuleTitle" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock x:Name="ModuleDescription" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,22"/>
    <ContentControl x:Name="ModuleContent" HorizontalContentAlignment="Stretch"/>
   </StackPanel>
  </Border>
  <TextBlock x:Name="WorkspaceStatus" TextWrapping="Wrap" Margin="4,12,4,0" Foreground="{StaticResource MutedTextBrush}"/>
 </StackPanel>
</UserControl>
