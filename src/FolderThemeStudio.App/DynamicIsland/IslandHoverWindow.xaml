<Window x:Class="FolderThemeStudio.App.DynamicIsland.IslandHoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动岛详情" Width="328" MaxWidth="328" Height="112" MaxHeight="180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/>
      <Style x:Key="Transport" TargetType="Button"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="15"/><Setter Property="Background" Value="#F0F0F5"/><Setter Property="BorderThickness" Value="0"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="15" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E0E7F9"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
    </Window.Resources>
    <Border Background="#FAF7F7FA" BorderBrush="#24808080" BorderThickness=".8" CornerRadius="16" Padding="15,12" ClipToBounds="True">
        <StackPanel>
            <TextBlock Text="{Binding HoverTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#30303C"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Height="18"/>
            <TextBlock Text="{Binding HoverBody}" FontSize="11" Foreground="#686874"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="17"
                       LineStackingStrategy="BlockLineHeight" MaxHeight="34"/>
            <StackPanel Visibility="{Binding HasMediaSession, Converter={StaticResource Visible}}" Margin="0,8,0,6">
             <TextBlock Text="{Binding MusicSourceDetail}" FontSize="10" Foreground="#8B8B97" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
             <ProgressBar Value="{Binding MusicProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="3" Foreground="#A3A1E5" Background="#E4E4EB" BorderThickness="0"/>
             <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding MusicTimeline}" FontSize="10" Foreground="#8B8B97" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding MediaControlsEnabled}">
               <Button Style="{StaticResource Transport}" Content="&#xE892;" ToolTip="上一首" AutomationProperties.Name="上一首" Click="Previous_Click"/>
               <Button Style="{StaticResource Transport}" Content="{Binding PlaybackGlyph}" ToolTip="{Binding PlaybackLabel}" AutomationProperties.Name="{Binding PlaybackLabel}" Click="Playback_Click"/>
               <Button Style="{StaticResource Transport}" Content="&#xE893;" ToolTip="下一首" AutomationProperties.Name="下一首" Click="Next_Click"/>
              </StackPanel>
             </Grid>
            </StackPanel>
            <TextBlock Text="{Binding MetricsDetail}" Visibility="{Binding ShowMetrics, Converter={StaticResource Visible}}" FontSize="10" Foreground="#777784" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
