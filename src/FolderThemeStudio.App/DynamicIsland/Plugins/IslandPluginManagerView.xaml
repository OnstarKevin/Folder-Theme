<UserControl x:Class="FolderThemeStudio.App.DynamicIsland.Plugins.IslandPluginManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FolderThemeStudio.App.Controls" FontFamily="Microsoft YaHei UI, Microsoft YaHei" FontSize="13" AllowDrop="True" Drop="Package_Drop" DragOver="Package_DragOver">
 <Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="插件，让灵动岛更懂你。" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="安装、配置与管理你的插件。" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,9,0,16"/>
   <WrapPanel><Button x:Name="InstallButton" Width="220" Style="{StaticResource FeatureCardButtonStyle}" Click="Install_Click" Margin="0,0,12,12"><StackPanel><TextBlock Text="＋  安装插件" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="选择 .islandpkg 文件" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0"/></StackPanel></Button><Button Width="220" Style="{StaticResource FeatureCardButtonStyle}" Click="Example_Click" Margin="0,0,0,12"><StackPanel><TextBlock Text="✦  专注与日程" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="自定义时长与每日提醒" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0"/></StackPanel></Button></WrapPanel>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0"><StackPanel>
   <TextBlock x:Name="EmptyText" Text="还没有 DIY 插件。将 .islandpkg 文件拖到这里。" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"/>
   <Border x:Name="ConsentPanel" Visibility="Collapsed" Background="#EAF2FF" CornerRadius="14" Padding="16" Margin="0,0,0,16"><StackPanel><TextBlock Text="插件数据权限" FontWeight="SemiBold"/><TextBlock x:Name="ConsentText" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button Content="授权并安装" Click="Approve_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="取消" Click="Decline_Click" Margin="8,0,0,0"/></WrapPanel></StackPanel></Border>
   <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="#F1F3FA" CornerRadius="14" Padding="16" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="SettingsTitle" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="由插件声明的设置项，保存后立即通知运行中的插件。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/><StackPanel x:Name="SettingsFields"/><TextBlock x:Name="SettingsError" Foreground="#B52E38" TextWrapping="Wrap" Margin="0,4,0,8"/><WrapPanel><Button Content="保存设置" Style="{StaticResource PrimaryButtonStyle}" Click="SaveSettings_Click"/><Button Content="取消" Click="CancelSettings_Click" Margin="8,0,0,0"/></WrapPanel></StackPanel></Border>
   <TextBlock Text="已安装" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,12"/>
   <ItemsControl x:Name="PluginList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
    <Border Width="300" Background="#F5F6FA" BorderBrush="#1A808080" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,12,12"><StackPanel>
     <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding Permissions}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,14"/>
     <WrapPanel><Button Content="设置" Click="Settings_Click" Tag="{Binding Id}" IsEnabled="{Binding HasSettings}"/><Button Content="{Binding ToggleLabel}" Click="Toggle_Click" Tag="{Binding Id}" Margin="6,0,0,0"/><Button Content="移除" Click="Remove_Click" Tag="{Binding Id}" Margin="6,0,0,0"/></WrapPanel>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Expander Header="用 AI 制作我的插件" Margin="0,20,0,10"><StackPanel Margin="0,12,0,0"><TextBlock Text="先将前置提示词发给 AI，等它询问后再发送你的需求。生成插件包后拖入这里。" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/><TextBox x:Name="PromptBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="180" VerticalScrollBarVisibility="Auto" Margin="0,10"/><Button Content="复制 AI 提示词" Click="CopyPrompt_Click" HorizontalAlignment="Left"/></StackPanel></Expander>
   <Expander Header="开发者 · Hook 协议与权限" Margin="0,10"><StackPanel Margin="0,12,0,0"><TextBlock Text="API v1：onInit / onEvent / onTick / onDispose。通过 island.publish 发布单行内容，island.clear 清除。宿主保留尺寸、透明和穿透控制。" TextWrapping="Wrap"/><TextBlock Text="事件按 media.read、clipboard.read、notifications.read 权限转发。对应内置模块关闭时，不采集或发送其数据。此版本不支持网络、系统命令或 DLL 插件。" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/><Button Content="导出完整 SDK 与示例" Click="ExportSdk_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Expander>
  </StackPanel></ScrollViewer>
  <TextBlock Grid.Row="2" x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0"/>
 </Grid>
</UserControl>
